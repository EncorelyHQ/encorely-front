{
  "expo": {
    "name": "Encorely",
    "slug": "encorely-app",
    "scheme": "encorely",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#121110",
    "plugins": [
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": false
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "enableBackgroundRecording": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Encorely usa la cámara solo para escanear el código de seguridad de tu match y verificar que nadie más lee el chat.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6A2B",
          "defaultChannel": "messages"
        }
      ],
      "expo-web-browser",
      "expo-asset",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#121110",
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121110"
          }
        }
      ]
    ],
    "experiments": {
      "tsconfigPaths": true,
      "typedRoutes": false
    },
    "extra": {
      "spotifyClientId": "30306a5149be49afb8dc14a58a611b1c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.encorely.app"
    },
    "android": {
      "package": "com.encorely.app",
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#121110",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    }
  }
}
